# Copy to .env if you want overrides. Defaults work for local demos.

POSTGRES_DB=ats
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_PORT=5432

WEB_PORT=8080

# Resource caps as if the stack ran on a small rented VPS (defaults: 2 vCPU / 4 GiB).
# Totals = postgres + backend + web. Recreate after changes: docker compose up -d --force-recreate
POSTGRES_CPUS=0.50
POSTGRES_MEMORY=1G
POSTGRES_CPUS_RESERVE=0.10
POSTGRES_MEMORY_RESERVE=256M

BACKEND_CPUS=1.25
BACKEND_MEMORY=2816M
BACKEND_CPUS_RESERVE=0.25
BACKEND_MEMORY_RESERVE=768M

WEB_CPUS=0.25
WEB_MEMORY=256M
WEB_CPUS_RESERVE=0.05
WEB_MEMORY_RESERVE=64M

# Heap as a share of the backend container memory (cgroup-aware).
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Comma-separated browser origins allowed to call the API directly (not needed for same-origin nginx).
ATS_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost,http://localhost:5173

ATS_RATE_LIMIT_CREATES_PER_MINUTE=30
